{
  "name": "magpie-page-d-message",
  "description": "Capture, inspect, edit and replay LLM requests through Magpie.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeePunk42/D-mesage.git"
  },
  "keywords": ["magpie-plugin", "magpie-page", "llm-debugging"],
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "main": "./plugin.js",
  "files": ["*.js", "*.mjs", "page/", "ui/", "patches/", "README.zh-CN.md"],
  "scripts": {
    "test": "bun test",
    "setup": "bun setup.js"
  },
  "magpie": {
    "name": "D-message",
    "icon": "https://raw.githubusercontent.com/DeePunk42/D-mesage/main/page/icon.png",
    "summary": {
      "en": "Inspect LLM traffic and replay edited requests from a local workspace.",
      "zh": "在本机查看大模型请求与响应，编辑请求并重放。"
    },
    "hooks": "./capture.hooks.js",
    "page": {
      "title": "D-message",
      "icon": "page/icon.png",
      "file": "page/start.html",
      "service": {
        "port": 34891,
        "option": "port"
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.328",
    "@modelcontextprotocol/sdk": "1.32.2",
    "diff": "9.0.0",
    "zod": "4"
  }
}
