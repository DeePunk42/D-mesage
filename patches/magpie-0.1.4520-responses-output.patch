+func TestGatewayHookResponsesStreamedItems(t *testing.T) {
+	const events = "data: {\"type\":\"response.output_item.done\",\"output_index\":1,\"item\":{\"type\":\"function_call\",\"name\":\"lookup\",\"arguments\":\"{}\"}}\n\n" +
+		"data: {\"type\":\"response.output_item.done\",\"output_index\":0,\"item\":{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"hello\"}]}}\n\n"
+	for _, tc := range []struct{ terminal, want string }{
+		{`[]`, `[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"hello"}]},{"type":"function_call","name":"lookup","arguments":"{}"}]`},
+		{`[{"type":"reasoning","id":"rs1"}]`, `[{"type":"reasoning","id":"rs1"}]`},
+	} {
+		body := events + `data: {"type":"response.completed","response":{"status":"completed","output":` + tc.terminal + "}}\n\n"
+		reply, err := gatewayReply(provider.Responses, []byte(body))
+		if err != nil {
+			t.Fatal(err)
+		}
+		var r struct{ Output json.RawMessage }
+		if err := json.Unmarshal(reply, &r); err != nil || string(r.Output) != tc.want {
+			t.Fatalf("streamed output: %s, error: %v", r.Output, err)
+		}
+	}
+	if _, err := gatewayReply(provider.Responses, []byte(events)); err == nil {
+		t.Fatal("stream without completion was accepted")
+	}
+}
